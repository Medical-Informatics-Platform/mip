# Versions
EXAFLOW=1.1.0
PLATFORM_BACKEND=9.3.0
PLATFORM_UI=1.2.0
MIP=9.1.0

# Toggle authentication
AUTHENTICATION=0

# Frontend base URL used for post-logout redirect.
PLATFORM_UI_BASE_URL=http://localhost

# JupyterLab token for the local mip_jupyter service (not used in Kubernetes).
JUPYTER_TOKEN=dev

# Optional bearer token for notebook calls when AUTHENTICATION=1.
MIP_TOKEN=

# External Keycloak
KEYCLOAK_AUTH_URL=https://iam.ebrains.eu/auth/
KEYCLOAK_REALM=MIP
KEYCLOAK_CLIENT_ID=mippublic
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_SSL_REQUIRED=none
