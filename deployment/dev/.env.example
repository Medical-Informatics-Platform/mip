# Versions
EXAFLOW=1.3.0
PLATFORM_BACKEND=11.0.0
PLATFORM_UI=3.0.0
MIP_JUPYTER=0.3.0
MIP=9.3.0

# Toggle authentication
AUTHENTICATION=0

# Frontend base URL used for post-logout redirect.
PLATFORM_UI_BASE_URL=http://localhost

# JupyterLab (published on 127.0.0.1:8888 only).
JUPYTER_TOKEN=dev
# Keycloak access token for the notebook client; required when AUTHENTICATION=1.
MIP_TOKEN=
# Optional: local checkout of the public mip-examples repo, mounted read-only as the
# notebook `examples/` folder. Default: ./mip-examples (empty if absent).
MIP_EXAMPLES_DIR=

# External Keycloak
KEYCLOAK_AUTH_URL=https://iam.ebrains.eu/auth/
KEYCLOAK_REALM=MIP
KEYCLOAK_CLIENT_ID=mippublic
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_SSL_REQUIRED=none
# Public Keycloak client for the mip Python client on users' own computers
# (account-page tokens and `mip login`). Empty: not offered.
KEYCLOAK_CLI_CLIENT_ID=
# Bearer tokens must also name this client in aud. Set together with
# KEYCLOAK_CLI_CLIENT_ID, once all this deployment's clients issue such tokens.
KEYCLOAK_REQUIRED_AUDIENCE=
# Require DPoP-bound tokens for the local client. Turn on only together with
# DPoP on the local client in Keycloak and a DPoP-capable mip-client.
KEYCLOAK_CLI_REQUIRE_DPOP=false
# Origin the UI's Content-Security-Policy allows for Keycloak, e.g. https://iam.ebrains.eu.
KEYCLOAK_ORIGIN=
