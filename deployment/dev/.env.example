# Versions
EXAFLOW=1.2.1
PLATFORM_BACKEND=10.2.0
PLATFORM_UI=2.1.1
MIP_JUPYTER=0.2.1
MIP=9.2.1

# Toggle authentication
AUTHENTICATION=0

# Frontend base URL used for post-logout redirect.
PLATFORM_UI_BASE_URL=http://localhost

# JupyterLab (published on 127.0.0.1:8888 only).
JUPYTER_TOKEN=dev
# Keycloak access token for the notebook client; required when AUTHENTICATION=1.
MIP_TOKEN=
# Optional: local checkout of the public mip-examples repo, mounted read-only as the
# notebook `examples/` folder. Default: ./mip-examples (empty if absent).
MIP_EXAMPLES_DIR=

# External Keycloak
KEYCLOAK_AUTH_URL=https://iam.ebrains.eu/auth/
KEYCLOAK_REALM=MIP
KEYCLOAK_CLIENT_ID=mippublic
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_SSL_REQUIRED=none
