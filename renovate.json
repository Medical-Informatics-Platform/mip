{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump tool versions and their pinned release-asset SHA256 in CI setup scripts",
      "managerFilePatterns": [
        "/(^|/)setup-tools\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n[A-Z_]+_VERSION=\"\\$\\{[A-Z_]+_VERSION:-(?<currentValue>v[0-9][0-9.]*)\\}\"\\n[A-Z_]+_SHA256=\"\\$\\{[A-Z_]+_SHA256:-(?<currentDigest>[a-f0-9]{64})\\}\""
      ]
    },
    {
      "customType": "regex",
      "description": "Bump python-version pinned in workflow files",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n\\s*python-version:\\s*'(?<currentValue>[0-9][0-9.]*)'"
      ]
    },
    {
      "currentValueTemplate": "develop",
      "customType": "regex",
      "description": "Track a git branch head pinned as a commit SHA in CI setup scripts",
      "managerFilePatterns": [
        "/(^|/)setup-tools\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>[^\\s]+)\\n[A-Z_]+_REF=\"\\$\\{[A-Z_]+_REF:-(?<currentDigest>[a-f0-9]{40})\\}\""
      ]
    }
  ],
  "extends": [
    "config:recommended"
  ],
  "github-actions": {
    "enabled": false
  },
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Never update a checksum for an existing version: a re-uploaded release asset must fail CI, not be auto-repinned",
      "enabled": false,
      "matchDatasources": [
        "github-release-attachments"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "description": "Cooldown: only propose releases at least 7 days old, so yanked or compromised releases never reach a PR",
      "matchDatasources": [
        "github-release-attachments",
        "github-tags",
        "github-releases",
        "python-version",
        "git-refs"
      ],
      "minimumReleaseAge": "7 days"
    }
  ]
}
